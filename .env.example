# Copie para .env e preencha. Nunca versione o .env.

# Obrigatória: chave das sessões, com pelo menos 32 caracteres aleatórios.
# Para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Banco PostgreSQL. Este valor corresponde ao infra/docker-compose.yml, para desenvolvimento.
# Vazio: banco em memória, em que os dados somem ao reiniciar. Em produção é obrigatória.
DATABASE_URL=postgresql://plannio:plannio@localhost:5433/plannio_dev

PORT=3001
NODE_ENV=development

# Endereço público do site. Em produção precisa ser https; na Vercel é detectado sozinho.
APP_URL=http://localhost:5173
